# ==============================
# BACKEND ENVIRONMENT VARIABLES
# ==============================

# Node.js configuration variables
NODE_ENV=
PORT=
LOGFILE_NAME=

# Amount (in MB) per second to throttle
THROTTLE_MB_PER_SECOND=

# URLs externas permitidas para realizar peticiones al backend
# Allowed URLs to consume this web service.
ALLOWED_ORIGINS= # Comma-separated, with no spaces (http://localhost:3000,http://localhost:5173)

# Max requests before being blocked by the rate limit
LIMIT=