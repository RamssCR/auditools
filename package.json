{
  "name": "auditools",
  "version": "1.0.0",
  "description": "A set of native functions to manipulate audio samples.",
  "main": "dist/app.js",
  "type": "module",
  "license": "ISC",
  "author": "RamssCR",
  "keywords": [
    "C++",
    "Audio",
    "Web Service",
    "Native Addon",
    "TypeScript"
  ],
  "scripts": {
    "addon:build": "cmake-js build",
    "addon:rebuild": "cmake-js rebuild",
    "start": "node dist/app.js",
    "dev": "tsx --watch --env-file-if-exists .env src/app.ts",
    "lint": "eslint --ext .ts .",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "format": "prettier --write",
    "test": "vitest --coverage --reporter=default --reporter=html",
    "test:coverage": "vitest --coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cmake-js": "^8.0.0",
    "commitlint": "^21.2.4",
    "eslint": "^10.13.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "node-addon-api": "^8.9.2",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/throttle": "^3.0.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "**/*.{ts,mts}": [
      "prettier --write",
      "eslint --fix",
      "vitest --changed"
    ]
  },
  "binary": {
    "napi_versions": [
      7
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
